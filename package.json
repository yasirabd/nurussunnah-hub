{
    "name": "nurussunnah-hub",
    "version": "0.1.0",
    "private": true,
    "scripts": {
        "dev": "next dev",
        "dev:webpack": "next dev --webpack",
        "dev:clean": "node -e \"require('node:fs').rmSync('.next/dev', { recursive: true, force: true })\" && next dev",
        "build": "next build",
        "test": "node --test tests/*.test.mjs",
        "test:codex-kanban": "node --test tests/codex-kanban-config.test.mjs",
        "codex:kanban": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/codex-kanban-launcher.ps1 -ProjectOwner yasirabd -ProjectNumber 2",
        "codex:kanban:dry-run": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/codex-kanban-launcher.ps1 -ProjectOwner yasirabd -ProjectNumber 2 -DryRun",
        "start": "next start",
        "lint": "eslint",
        "migrate": "node scripts/migrate.mjs",
        "seed": "node scripts/seed.mjs",
        "build:cloudflare": "opennextjs-cloudflare build",
        "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
        "preview:cloudflare": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
        "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
        "deploy:cloudflare": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
        "upload": "opennextjs-cloudflare build && opennextjs-cloudflare upload",
        "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts"
    },
    "dependencies": {
        "@base-ui/react": "^1.4.1",
        "@google/design.md": "^0.3.0",
        "@hookform/resolvers": "^5.2.2",
        "@radix-ui/react-label": "^2.1.8",
        "@radix-ui/react-slot": "^1.2.4",
        "@supabase/ssr": "^0.10.2",
        "@supabase/supabase-js": "^2.105.3",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "jszip": "^3.10.1",
        "lucide-react": "^1.14.0",
        "modern-screenshot": "^4.7.0",
        "next": "^16.2.6",
        "next-themes": "^0.4.6",
        "react": "19.2.4",
        "react-dom": "19.2.4",
        "react-hook-form": "^7.75.0",
        "shadcn": "^4.7.0",
        "sonner": "^2.0.7",
        "tailwind-merge": "^3.5.0",
        "tw-animate-css": "^1.4.0",
        "vaul": "^1.1.2",
        "xlsx": "^0.18.5",
        "zod": "^4.4.3"
    },
    "devDependencies": {
        "@opennextjs/cloudflare": "^1.19.11",
        "@tailwindcss/postcss": "^4",
        "@types/node": "^20",
        "@types/react": "^19",
        "@types/react-dom": "^19",
        "eslint": "^9",
        "eslint-config-next": "^16.2.6",
        "tailwindcss": "^4",
        "typescript": "^5",
        "wrangler": "^4.98.0"
    }
}
